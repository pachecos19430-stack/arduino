rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global security primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Health check endpoint for connection validation
    match /test/{docId} {
      allow read: if true;
    }

    // Users Collection
    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 128 &&
             data.role in ['admin', 'maker', 'developer', 'viewer'];
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (resource.data.id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUser(incoming()) && (isAdmin() || incoming().role == existing().role);
      allow delete: if isAdmin();
    }

    // Boards Collection (Hardware Specifications)
    function isValidBoard(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 128 &&
             data.family in ['arduino', 'esp32', 'esp8266', 'raspberry_pi_pico', 'stm32', 'other'] &&
             data.operatingVoltage in ['5V', '3.3V', 'dual'];
    }

    match /boards/{boardId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(boardId) && isValidBoard(incoming());
      allow delete: if isAdmin();
    }

    // Components Collection (Sensors, Actuators, Displays)
    function isValidComponent(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 128 &&
             data.category in ['sensor', 'actuator', 'display', 'input', 'power', 'communication', 'passive'];
    }

    match /components/{componentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(componentId) && isValidComponent(incoming());
      allow delete: if isAdmin();
    }

    // Projects Collection
    function isValidProject(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
             data.status in ['planning', 'prototyping', 'testing', 'deployed', 'archived'] &&
             data.boardId is string && data.boardId.size() <= 128;
    }

    match /projects/{projectId} {
      allow get: if isSignedIn() && isValidId(projectId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(projectId) && incoming().userId == request.auth.uid && isValidProject(incoming());
      allow update: if isSignedIn() && isValidId(projectId) && resource.data.userId == request.auth.uid && incoming().userId == request.auth.uid && isValidProject(incoming());
      allow delete: if isSignedIn() && isValidId(projectId) && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Project Components Collection
    function isValidProjectComponent(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.projectId is string && data.projectId.size() <= 128 &&
             data.componentCatalogId is string && data.componentCatalogId.size() <= 128 &&
             data.customLabel is string && data.customLabel.size() <= 128 &&
             data.quantity is number && data.quantity >= 0;
    }

    match /projectComponents/{projectComponentId} {
      allow get: if isSignedIn() && isValidId(projectComponentId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(projectComponentId) && isValidProjectComponent(incoming());
      allow delete: if isSignedIn() && isValidId(projectComponentId);
    }

    // Connections Collection
    function isValidConnection(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.projectId is string && data.projectId.size() <= 128 &&
             data.boardPin is string && data.boardPin.size() <= 64 &&
             data.componentPin is string && data.componentPin.size() <= 64;
    }

    match /connections/{connectionId} {
      allow get: if isSignedIn() && isValidId(connectionId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(connectionId) && isValidConnection(incoming());
      allow delete: if isSignedIn() && isValidId(connectionId);
    }

    // Tests Collection
    function isValidTest(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.projectId is string && data.projectId.size() <= 128 &&
             data.title is string && data.title.size() <= 128 &&
             data.severity in ['low', 'medium', 'high', 'critical'];
    }

    match /tests/{testId} {
      allow get: if isSignedIn() && isValidId(testId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(testId) && isValidTest(incoming());
      allow delete: if isSignedIn() && isValidId(testId);
    }

    // Test Results Collection
    function isValidTestResult(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.projectId is string && data.projectId.size() <= 128 &&
             data.testId is string && data.testId.size() <= 128 &&
             data.status in ['passed', 'failed', 'inconclusive'];
    }

    match /testResults/{testResultId} {
      allow get: if isSignedIn() && isValidId(testResultId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(testResultId) && isValidTestResult(incoming());
      allow delete: if isSignedIn() && isValidId(testResultId);
    }

    // Telemetry Collection
    function isValidTelemetry(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.projectId is string && data.projectId.size() <= 128 &&
             data.metric is string && data.metric.size() <= 64;
    }

    match /telemetry/{telemetryId} {
      allow get: if isSignedIn() && isValidId(telemetryId);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(telemetryId) && isValidTelemetry(incoming());
      allow delete: if isSignedIn() && isValidId(telemetryId);
    }

    // System Logs Collection
    function isValidLog(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.level in ['info', 'warn', 'error', 'debug'] &&
             data.message is string && data.message.size() <= 1000;
    }

    match /logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(logId) && isValidLog(incoming());
      allow update: if false; // Logs are append-only / immutable
      allow delete: if isAdmin();
    }
  }
}
